{
  "name": "instagram-clone",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "format": "bunx @biomejs/biome format --write ./src",
    "check": "bunx @biomejs/biome check ./src",
    "prepare": "husky",
    "test": "bun test --env-file=.env.test",
    "lint": "biome check ./src",
    "db:studio": "drizzle-kit studio --host=0.0.0.0 --config=src/config/drizzle.config.ts",
    "db:generate:migration": "drizzle-kit generate --config=src/config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/config/drizzle.config.ts",
    "db:reset": "bun run ./scripts/reset.script.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "hono": "^4.12.18",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "zeptomail": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check",
      "sh -c 'bunx tsc --noEmit'"
    ]
  }
}
