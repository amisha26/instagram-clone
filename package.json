{
  "name": "instagram-clone",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "format": "bunx @biomejs/biome format --write ./src",
    "check": "bunx @biomejs/biome check ./src",
    "prepare": "husky",
    "test": "bun test",
    "lint": "biome check ./src"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "hono": "^4.12.18",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4"
  },
  "lint-staged": {
  "*.{ts,tsx}": [
    "biome check",
    "bunx tsc --noEmit --ignoreConfig"
  ]
}
}
